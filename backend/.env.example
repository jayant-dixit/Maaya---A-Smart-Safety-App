# Maaya Backend Configuration Example
PORT=8080
NODE_ENV=development

# PostgreSQL Connection URL
DATABASE_URL=postgresql://maaya_admin:maaya_secure_dev_password@localhost:5432/maaya_db

# Cryptographic Secret for Expiring JWT Access Tokens
JWT_SECRET=dev_super_secret_jwt_key_change_in_production_32chars

# Contact Dashboard URL (for generating live SMS links)
DASHBOARD_URL=http://localhost:5173

# SMS Provider: 'mock' (prints to log) or 'twilio'
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
