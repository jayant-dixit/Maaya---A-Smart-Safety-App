# ==============================================================================
# MAAYA SAFETY & EMERGENCY RESPONSE PLATFORM - ROOT .GITIGNORE
# Covers Android (Kotlin/Gradle), Backend (Node.js/TS), Web Dashboard (Vite),
# Docker, Environment Secrets, Media Assets, and IDE Configs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Secrets (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
dashboard/.env.local
dashboard/.env.*.local
!dashboard/.env.example

# ------------------------------------------------------------------------------
# 2. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 3. Editors & IDEs
# ------------------------------------------------------------------------------
# JetBrains / Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
.navigation/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# ------------------------------------------------------------------------------
# 4. Android (Kotlin, Gradle, Android Studio)
# ------------------------------------------------------------------------------
# Gradle cache & build directories
.gradle/
build/
*/build/
android/.gradle/
android/build/
android/*/build/
android/app/build/
android/.cxx/
android/app/.cxx/

# Local developer SDK configuration
local.properties
android/local.properties

# Android package artifacts
*.apk
*.ap_
*.aab
*.dex
*.class

# Android Studio profiler captures
captures/
android/captures/

# Keystores & Signing credentials
*.jks
*.keystore
*.p12
*.key
signing.properties
android/release-key.properties

# ------------------------------------------------------------------------------
# 5. Node.js & Web Projects (Backend & Dashboard)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
*/node_modules/
backend/node_modules/
dashboard/node_modules/

# Production build outputs
dist/
*/dist/
backend/dist/
backend/build/
dashboard/dist/
dashboard/dist-ssr/

# Node package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# Runtime media evidence & uploads
backend/public/recordings/*
!backend/public/recordings/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/tmp/

# PID & runtime lock files
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 6. Database & Docker Volume Persistence
# ------------------------------------------------------------------------------
pgdata/
postgres_data/
docker/data/

# ------------------------------------------------------------------------------
# 7. Testing, Coverage & Cache
# ------------------------------------------------------------------------------
coverage/
*/coverage/
.nyc_output/
.eslintcache
.stylelintcache
*.lcov
.cache/
.temp/
tmp/
